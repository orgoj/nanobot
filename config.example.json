{
  "agents": {
    "defaults": {
      "workspace": "~/.nanobot/workspace",
      "model": "anthropic/claude-3-5-sonnet",
      "max_tokens": 8192,
      "temperature": 0.7,
      "max_tool_iterations": 20,
      "subagent_max_iterations": 25,
      "startup_prompt": null,
      "startup_target": "cli:direct",
      "heartbeat_on_start": false,
      "heartbeat_target": "cli:direct",
      "stream_intermediate_responses": false,
      "features": {
        "multi_agent": false,
        "journaling": false
      }
    }
  },
  "context": {
    "context_plugin_package": "nanobot.agent.context",
    "context_plugin_class": "ContextBuilder",
    "context_plugin_config": null
  },
  "logging": {
    "fileLoggingEnabled": true,
    "fileLogPath": null,
    "logFullMessages": false,
    "logFullToolArgs": false
  },
  "memory": {
    "max_long_term_lines": 50,
    "max_daily_lines": 100,
    "include_recent_days": 3
  },
  "tools": {
    "restrict_to_workspace": false,
    "web": {
      "search": {
        "api_key": "",
        "max_results": 5
      }
    },
    "exec": {
      "timeout": 60
    }
  },
  "providers": {
    "anthropic": {
      "api_key": "sk-ant-...",
      "api_base": null,
      "extra_headers": null
    },
    "openai": {
      "api_key": "sk-...",
      "api_base": null,
      "extra_headers": null
    },
    "openrouter": {
      "api_key": "sk-or-...",
      "api_base": null,
      "extra_headers": null
    }
  },
  "channels": {
    "telegram": {
      "enabled": false,
      "token": "",
      "allow_from": []
    },
    "discord": {
      "enabled": false,
      "token": "",
      "allow_from": []
    }
  }
}
