{
  "agents": {
    "defaults": {
      "workspace": "/home/nanobot/workspace",
      "model": "glm-4.7",
      "startup_prompt": "Hello! I am online. Please check HEARTBEAT.md and resume any pending tasks.",
      "startup_target": "telegram:YOUR_TELEGRAM_USER_ID",
      "heartbeat_on_start": true,
      "heartbeat_target": "telegram:YOUR_TELEGRAM_USER_ID"
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "token": "YOUR_TELEGRAM_BOT_TOKEN",
      "allow_from": ["YOUR_TELEGRAM_USER_ID"]
    }
  },
  "providers": {
    "zhipu": {
      "api_key": "YOUR_ZHIPU_OR_Z_AI_API_KEY",
      "api_base": "https://api.z.ai/api/coding/paas/v4"
    }
  },
  "tools": {
    "restrict_to_workspace": true,
    "exec": {
      "timeout": 60
    }
  }
}
